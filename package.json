{
  "name": "maa-pipeline.nvim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "stylecheck": "npm run lint && npm run format:check",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nekosu/maa-locale": "1.2.0",
    "@nekosu/maa-pipeline-manager": "1.1.0",
    "@nekosu/maa-server": "0.3.0",
    "@nekosu/maa-server-proto": "0.3.0",
    "@nekosu/maa-version-manager": "1.1.0",
    "jsonc-parser": "^3.3.1",
    "pacote": "^21.5.1",
    "tar": "7.5.22",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "imports": {
    "#server/*": "./server/*"
  }
}
