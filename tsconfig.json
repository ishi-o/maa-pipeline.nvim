{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "#server/*": ["./server/*"]
    }
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
